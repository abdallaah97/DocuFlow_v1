{
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=DocuFlowDbV1;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "jwt": {
    "Issuer": "DocuFlow",
    "Audience": "DocuFlow.Users",
    "Key": "DEV-ONLY-change-me-this-key-must-be-at-least-32-chars",
    "ExpiryMinutes": 15
  },
  "refreshToken": {
    "ExpiryDays": 7
  }
}
